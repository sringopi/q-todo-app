# Environment Configuration Example for TODO API
# Copy this file to .env and update with your actual values

# IP Allowlist - Comma-separated list of allowed IP addresses
# Example: IP_ALLOWLIST=192.168.1.100,10.0.0.50,203.0.113.1
IP_ALLOWLIST=your.ip.address.here

# Application Configuration
DEBUG=true
APP_NAME=TODO API
VERSION=1.0.0

# Database Configuration (when implemented)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Redis Configuration (when implemented)
# REDIS_URL=redis://localhost:6379

# Security Configuration
# SECRET_KEY=your-secret-key-here
# JWT_SECRET_KEY=your-jwt-secret-key

# API Configuration
# API_V1_STR=/api/v1
# CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]

# Logging Configuration
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# External Services (when implemented)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
