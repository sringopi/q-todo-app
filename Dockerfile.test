# Use Python 3.11 slim image as base
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first to leverage Docker cache
COPY requirements.txt .

# Create test requirements with additional testing tools
RUN echo "pytest-cov==4.0.0" >> requirements.txt \
    && echo "pytest-html==4.1.1" >> requirements.txt \
    && echo "pytest-xdist==3.5.0" >> requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create directories for test results
RUN mkdir -p /app/test-results

# Create non-root user for security
RUN adduser --disabled-password --gecos '' --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

# Default command runs tests
CMD ["pytest", "-v", "--cov=app", "--cov-report=term", "--cov-report=html:/app/test-results/htmlcov"]
